    "operation": "shape.create",
    "parameters": {
      "name": "CoreXY 3D printer",
      "description": "CoreXY FDM printer with a 220 mm cube build volume. Frame of cut 2020 T-slot extrusion (true slot profile) with printed PETG gussets; MGN12 Y rails on the top frame, a 2020 X beam on their carriages, MGN9 X rail and a printed toolhead shroud carrying heatsink, milled heater block and turned brass nozzle. The bed rides two \u00d88 rods and a lead screw at the back on a laser-cut yoke. The print-height parameter moves the bed.",
      "source": {
        "$file": "printer.js"
      },
      "params": [
        {
          "key": "build",
          "label": "Build volume",
          "value": 220,
          "unit": "mm",
          "min": 120,
          "max": 400
        },
        {
          "key": "printHeight",
          "label": "Print height (bed position)",
          "value": 60,
          "unit": "mm",
          "min": 0,
          "max": 220
        }
      ],
      "display_tolerance": 0.02,
      "materials": {
        "Aluminium": "$0.id",
        "PETG": "$1.id",
        "Steel": "$2.id",
        "Brass": "$3.id",
        "Rubber": "$4.id",
        "Silicone": "$5.id",
        "FR4": "$6.id",
        "Stepper motor": "$7.id"
      }
    }
  },
  {
    "operation": "intent.requirement.create",
    "parameters": {
      "name": "No clashes anywhere in the printer",
      "rule": {
        "kind": "no_collisions",
        "parts": [
          "$8.id"
        ]
      }
    }
  },
  {
    "operation": "intent.requirement.create",
