[
  {
    "operation": "solid.material.create",
    "parameters": { "name": "Steel", "density": { "value": 7850, "unit": "kg/m3" } }
  },
  {
    "operation": "shape.create",
    "parameters": {
      "name": "M8 × 30 hex bolt",
      "description": "ISO 4017-style hex bolt with a true ISO 68-1 metric thread (60° flanks, P/8 crest and P/4 root flats), 30° head chamfer and 45° tip chamfer.",
      "source": { "$file": ["thread.js", "bolt.js"] },
      "params": [
        { "key": "diameter", "label": "Thread diameter", "value": 8, "unit": "mm", "min": 2, "max": 48 },
        { "key": "pitch", "label": "Pitch", "value": 1.25, "unit": "mm", "min": 0.25, "max": 6, "step": 0.05 },
        { "key": "length", "label": "Length", "value": 30, "unit": "mm", "min": 4, "max": 300 },
        { "key": "headAcross", "label": "Head across flats", "value": 13, "unit": "mm", "min": 3, "max": 80 },
        { "key": "headHeight", "label": "Head height", "value": 5.3, "unit": "mm", "min": 1, "max": 40, "step": 0.1 },
        { "key": "clearance", "label": "Thread clearance", "value": 0.05, "unit": "mm", "min": 0, "max": 0.5, "step": 0.01 }
      ],
      "material": "$0.id"
    }
  },
  {
    "operation": "shape.create",
    "parameters": {
      "name": "M8 hex nut",
      "description": "ISO 4032-style hex nut, 30° chamfers on both faces, internal ISO 68-1 thread cut by the same helix grown by the clearance. Placed 10 pitches up the bolt so the threads are in phase.",
      "source": { "$file": ["thread.js", "nut.js"] },
      "params": [
        { "key": "diameter", "label": "Thread diameter", "value": 8, "unit": "mm", "min": 2, "max": 48 },
        { "key": "pitch", "label": "Pitch", "value": 1.25, "unit": "mm", "min": 0.25, "max": 6, "step": 0.05 },
        { "key": "across", "label": "Across flats", "value": 13, "unit": "mm", "min": 3, "max": 80 },
        { "key": "height", "label": "Height", "value": 6.8, "unit": "mm", "min": 1, "max": 40, "step": 0.1 },
        { "key": "clearance", "label": "Thread clearance", "value": 0.05, "unit": "mm", "min": 0, "max": 0.5, "step": 0.01 }
      ],
      "placement": { "x": { "value": 0, "unit": "mm" }, "y": { "value": 0, "unit": "mm" }, "z": { "value": 17.8, "unit": "mm" } },
      "material": "$0.id"
    }
  },
  {
    "operation": "intent.requirement.create",
    "parameters": { "name": "Nut runs free on the bolt", "rule": { "kind": "clearance", "a": "$1.id", "b": "$2.id", "min": { "value": 0.02, "unit": "mm" } } }
  },
  {
    "operation": "intent.requirement.create",
    "parameters": { "name": "Threads do not interfere", "rule": { "kind": "no_collisions", "parts": ["$1.id", "$2.id"] } }
  }
]
